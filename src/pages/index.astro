---
import Layout from "../layouts/Layout.astro";

const versions = [
  { href: "/forge", title: "Forge" },
  { href: "/fabric", title: "Fabric" },
  { href: "/bedrock", title: "Bedrock" },
  { href: "/terraria", title: "Terraria" },
];
---

<Layout canonicalPath="/">
	<main class="flex w-full flex-1 flex-col items-center justify-center px-6 py-10">
		<div class="grid w-full max-w-3xl grid-cols-1 lg:grid-cols-2">
			{versions.map((version) => (
				<a
					href={version.href}
					class="m-2 rounded border-2 border-zinc-200 p-8 text-center transition-colors hover:border-sj2orange"
				>
					<h2 class="text-3xl font-bold">{version.title}</h2>
				</a>
			))}
		</div>
	</main>
</Layout>
